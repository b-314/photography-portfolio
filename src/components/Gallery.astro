---
import { Image } from "astro:assets";
import {
    getCategories,
    getImages,
    getImagesByCategory,
} from "../lib/gallery";

interface Props {
    category?: string;
}

const { category } = Astro.props;

const categories = getCategories();

const images = category
    ? getImagesByCategory(category)
    : getImages();

const heading = category
    ? category.charAt(0).toUpperCase() + category.slice(1)
    : "Gallery";
---

<section class="gallery-section">
    <aside class="gallery-sidebar">
        <h2>{heading}</h2>
        <nav>
            <a href="/" class="home-link">
                <span>Home</span>
                <span class="home-icon" aria-hidden="true">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M3 10.5L12 3L21 10.5V21H14.5V15H9.5V21H3V10.5Z"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linejoin="round"
                        />
                    </svg>
                </span>
            </a>

            <a
                href="/gallery/"
                class:list={{ active: !category }}
            >
                <span>All</span>
                <span class="arrow">↗</span>
            </a>

            {
                categories.map((cat) => (
                    <a
                        href={`/gallery/${cat}/`}
                        class:list={{ active: cat === category }}
                    >
                        <span>
                            {cat.charAt(0).toUpperCase() + cat.slice(1)}
                        </span>

                        <span class="arrow">↗</span>
                    </a>
                ))
            }
        </nav>
    </aside>

    <div class="gallery-grid">
        {
            images.map((photo, index) => (
                <figure
                    class="gallery-item"
                    data-index={index}
                    data-name={photo.name}
                >
                    <button
                        class="gallery-image-button"
                        type="button"
                        aria-label={`Open ${photo.name}`}
                    >
                        <Image
                            src={photo.image}
                            alt={photo.name}
                            loading="lazy"
                        />
                    </button>
                </figure>
            ))
        }

    </div>

</section>


<!-- LIGHTBOX -->

<div
    class="lightbox"
    id="lightbox"
    aria-hidden="true"
>
    <button
        class="lightbox-close"
        type="button"
        aria-label="Close image"
    >
        &times;
    </button>

    <button
        class="lightbox-arrow lightbox-prev"
        type="button"
        aria-label="Previous photo"
    >
        &#8592;
    </button>

    <div class="lightbox-content">
        <img
            class="lightbox-image"
            id="lightbox-image"
            src=""
            alt=""
        />
    </div>

    <button
        class="lightbox-arrow lightbox-next"
        type="button"
        aria-label="Next photo"
    >
        &#8594;
    </button>
</div>


<script>
    const galleryItems = document.querySelectorAll<HTMLElement>(".gallery-item");
    const lightbox = document.querySelector<HTMLElement>("#lightbox");
    const lightboxImage = document.querySelector<HTMLImageElement>("#lightbox-image");
    const closeButton = document.querySelector<HTMLButtonElement>(".lightbox-close");
    const previousButton = document.querySelector<HTMLButtonElement>(".lightbox-prev");
    const nextButton = document.querySelector<HTMLButtonElement>(".lightbox-next");

    if (
        lightbox &&
        lightboxImage &&
        closeButton &&
        previousButton &&
        nextButton
    ) {
        let currentIndex = 0;

        const images = Array.from(galleryItems).map((item) => {
            const image =
                item.querySelector<HTMLImageElement>("img");

            return {
                src: image?.src ?? "",
                alt: image?.alt ?? "",
            };
        });

        function showImage(index: number) {
            if (images.length === 0) {
                return;
            }

            currentIndex =
                (index + images.length) % images.length;

            const image = images[currentIndex];

            lightboxImage.src = image.src;
            lightboxImage.alt = image.alt;
        }

        function openLightbox(index: number) {
            showImage(index);

            lightbox.classList.add("open");
            lightbox.setAttribute("aria-hidden", "false");

            document.body.classList.add("lightbox-open");
        }

        function closeLightbox() {
            lightbox.classList.remove("open");
            lightbox.setAttribute("aria-hidden", "true");

            document.body.classList.remove("lightbox-open");

            lightboxImage.src = "";
            lightboxImage.alt = "";
        }

        function showPrevious() {
            showImage(currentIndex - 1);
        }

        function showNext() {
            showImage(currentIndex + 1);
        }

        galleryItems.forEach((item, index) => {
            const button =
                item.querySelector<HTMLButtonElement>(
                    ".gallery-image-button"
                );

            button?.addEventListener("click", () => {
                openLightbox(index);
            });
        });

        closeButton.addEventListener("click", closeLightbox);

        previousButton.addEventListener(
            "click",
            showPrevious
        );

        nextButton.addEventListener(
            "click",
            showNext
        );

        lightbox.addEventListener("click", (event) => {
            if (event.target === lightbox) {
                closeLightbox();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (!lightbox.classList.contains("open")) {
                return;
            }

            if (event.key === "Escape") {
                closeLightbox();
            }

            if (event.key === "ArrowLeft") {
                showPrevious();
            }

            if (event.key === "ArrowRight") {
                showNext();
            }
        });
    }
</script>